{%- assign title_bar_spacing = "" -%}
{%- unless hide_title_bar -%}
  {%- assign title_bar_spacing = " mb--3" -%}
{%- endunless -%}

{% if photo_ready %}
  <div class="layout rounded{{ title_bar_spacing }}" style="position: relative; padding: 0;">
    <img class="image image-dither image--cover w--full h--full" src="{{ image_url | escape }}" alt="{{ image_alt | default: title | escape }}">
    <div class="flex flex--col flex--left gap--xsmall" style="position: absolute; left: 8px; right: 8px; bottom: 8px;">
      <span class="title title--small text--white text-stroke text-stroke--black" data-clamp="2">
        {{ title | escape }}
      </span>
      <span class="description description--small text--white text-stroke text-stroke--black" data-clamp="3">
        {{ description | escape }}
      </span>
    </div>
  </div>
{% endif %}

{% unless photo_ready %}
  <div class="layout layout--col layout--center rounded">
    <span class="title">Today's photo is temporarily unavailable.</span>
    <span class="description">TRMNL will try again automatically.</span>
  </div>
{% endunless %}

{% unless hide_title_bar %}
  <div class="title_bar">
    <img class="image image-stroke" src="data:image/svg+xml;base64,{{ svg_logo | base64_encode }}" alt="National Geographic logo">
    <span class="title">National Geographic - Photo of the Day</span>
  </div>
{% endunless %}
